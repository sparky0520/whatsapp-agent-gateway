# Environment Configuration for WhatsApp Agent Gateway

ENVIRONMENT=production
LOG_LEVEL=INFO

# Gateway Host & Port
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
MOCK_LAB_HOST=0.0.0.0
MOCK_LAB_PORT=8001

# WhatsApp Cloud API Credentials
WHATSAPP_APP_SECRET=mock_secret_for_tests_only_3b9f
WHATSAPP_VERIFY_TOKEN=heydoc_verify_token_2026
WHATSAPP_PHONE_NUMBER_ID=109876543210123

# Database & Cache (Docker compose defaults)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/whatsapp_gateway
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=25
RATE_LIMIT_WINDOW_SECONDS=60

# Mock Lab API Settings
LAB_API_BASE_URL=http://localhost:8001
LAB_FAILURE_RATE=0.20
LAB_MIN_LATENCY_MS=500
LAB_MAX_LATENCY_MS=1500

# Retries with Exponential Backoff
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_BACKOFF=0.3
RETRY_MAX_BACKOFF=2.0

# LLM Configuration (Generic OpenAI-Compatible: DeepSeek, OpenRouter, Groq, Ollama, etc.)
# Set LLM_PROVIDER to "deepseek", "live", or "custom" and provide LLM_API_KEY for live mode (defaults to "mock")
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

# Token Pricing (DeepSeek baseline: $0.140 in, $0.280 out per 1M tokens)
COST_PER_1M_PROMPT_TOKENS_USD=0.140
COST_PER_1M_COMPLETION_TOKENS_USD=0.280
USD_TO_INR_RATE=85.0
